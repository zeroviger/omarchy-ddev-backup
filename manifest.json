{
  "schemaVersion": 1,
  "id": "mcp64.ddev-backup",
  "name": "DDEV Backup",
  "version": "1.2.0",
  "author": "Giuseppe Solla (MCP64)",
  "license": "MIT",
  "description": "Backup e restore completi dei progetti DDEV (sorgenti, configurazione e database) in un file .zip",
  "homepage": "https://github.com/zeroviger/omarchy-ddev-backup",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "DdevBackup.qml"
  },
  "barWidget": {
    "displayName": "DDEV Backup",
    "description": "Backup e restore dei progetti DDEV dalla barra",
    "category": "Development",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "backupDir": "~/Backups/ddev",
      "keep": 10,
      "keepDb": 20,
      "exclude": "node_modules",
      "notify": true
    },
    "schema": [
      {
        "key": "backupDir",
        "type": "string",
        "label": "Cartella dei backup",
        "defaultValue": "~/Backups/ddev"
      },
      {
        "key": "keep",
        "type": "integer",
        "label": "Backup completi da tenere per progetto (0 = tutti)",
        "min": 0,
        "max": 100,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "keepDb",
        "type": "integer",
        "label": "Backup del solo database da tenere (0 = tutti)",
        "min": 0,
        "max": 200,
        "step": 1,
        "defaultValue": 20
      },
      {
        "key": "exclude",
        "type": "string",
        "label": "Escludi dai backup (separati da virgola)",
        "defaultValue": "node_modules"
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Notifiche a fine backup e restore",
        "defaultValue": true
      }
    ]
  }
}
