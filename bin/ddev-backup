#!/bin/bash

# ddev-backup — backup e restore completi (file + database) di progetti DDEV
# in un singolo file .zip.
#
# Struttura dell'archivio:
#   manifest.json        metadati (progetto, tipo DB, database inclusi, git, sha256)
#   database/<db>.sql.gz un dump per ogni database utente del container db
#   files/...            l'intera cartella del progetto (sorgenti, .env, .ddev/)
#
# Output per il pannello: righe "STEP: ..." per l'avanzamento, "DONE: <path>"
# alla fine, "ERROR: ..." su stderr in caso di errore.

set -euo pipefail

VERSION="1.4.2"
FORMAT="ddev-backup"
FORMAT_VERSION=1

PLUGIN_ID="mcp64.ddev-backup"
SHELL_CONFIG="${OMARCHY_SHELL_CONFIG:-$HOME/.config/omarchy/shell.json}"

# Valori predefiniti: devono coincidere con barWidget.defaults nel manifest.
DEFAULT_BACKUP_DIR="$HOME/Backups/ddev"
DEFAULT_KEEP=10
DEFAULT_KEEP_DB=20
DEFAULT_EXCLUDE="node_modules"

# File generati da DDEV ad ogni avvio: rigenerabili, quindi esclusi.
DEFAULT_EXCLUDES=(
  "./.ddev/.ddev-docker-compose-*.yaml"
  "./.ddev/.webimageBuild"
  "./.ddev/.dbimageBuild"
  "./.ddev/.sshimageBuild"
  "./.ddev/.homeadditions"
  "./.ddev/.global_commands"
  "./.ddev/.importdb*"
  "./.ddev/.downloads"
  "./.ddev/db_snapshots"
  "./.ddev/xhprof/xhprof_html"
  "./.ddev/traefik/certs"
)

SYSTEM_DBS_MYSQL="information_schema mysql performance_schema sys"

die() {
  echo "ERROR: $*" >&2
  exit 1
}

step() {
  echo "STEP: $*"
}

# ---------------------------------------------------------------- impostazioni

# Le impostazioni sono quelle che il pannello salva (omarchy bar set) nella
# voce del widget in shell.json: bar.layout.<sezione>[] con id = PLUGIN_ID.
# Così pannello e terminale usano sempre gli stessi valori. Per i test si
# può indicare un file JSON con DDEV_BACKUP_CONFIG.
SETTINGS=""

load_settings() {
  [[ -z $SETTINGS ]] || return 0
  if [[ -n ${DDEV_BACKUP_CONFIG:-} ]]; then
    SETTINGS="$(jq -c 'if type == "object" then . else {} end' "$DDEV_BACKUP_CONFIG" 2>/dev/null)"
  else
    SETTINGS="$(jq -c --arg id "$PLUGIN_ID" '
      [(.bar.layout // {}) | .[]? | .[]? | select(type == "object" and .id == $id)][0] // {}
    ' "$SHELL_CONFIG" 2>/dev/null)"
  fi
  [[ -n $SETTINGS ]] || SETTINGS='{}'
}

# setting <chiave> <default> — "false" e 0 sono valori validi, non mancanti.
setting() {
  load_settings
  local value
  value="$(jq -r --arg k "$1" 'if .[$k] == null then empty
    elif (.[$k] | type) == "array" then .[$k] | join(",") else .[$k] | tostring end' <<<"$SETTINGS")"
  [[ -n $value ]] && echo "$value" || echo "$2"
}

backup_dir() {
  local dir
  dir="$(setting backupDir "$DEFAULT_BACKUP_DIR")"
  dir="${dir/#\~/$HOME}"
  [[ $dir == /* ]] || die "backupDir deve essere un percorso assoluto: $dir"
  echo "${dir%/}"
}

# keep_count full|database
keep_count() {
  local value
  if [[ $1 == database ]]; then value="$(setting keepDb "$DEFAULT_KEEP_DB")"
  else value="$(setting keep "$DEFAULT_KEEP")"; fi
  [[ $value =~ ^[0-9]+$ ]] && echo "$value" || echo 0
}

# Pattern da escludere, uno per riga (nelle impostazioni separati da virgola).
extra_excludes() {
  local pattern
  tr ',' '\n' <<<"$(setting exclude "$DEFAULT_EXCLUDE")" | while IFS= read -r pattern; do
    pattern="${pattern#"${pattern%%[![:space:]]*}"}"
    pattern="${pattern%"${pattern##*[![:space:]]}"}"
    [[ -n $pattern ]] && echo "$pattern"
  done
  return 0
}

notify() {
  local enabled="${DDEV_BACKUP_NOTIFY:-}"
  [[ -n $enabled ]] || { [[ "$(setting notify true)" == false ]] && enabled=0 || enabled=1; }
  [[ $enabled == 1 ]] || return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "DDEV Backup" "$@" >/dev/null 2>&1 || true
}

describe() {
  ddev describe -j "$1" 2>/dev/null | jq -c '.raw' 2>/dev/null
}

# Esegue un comando ddev nella cartella del progetto (ddev mysql/psql non
# accettano il nome del progetto come argomento).
in_project() {
  local root="$1"
  shift
  (cd "$root" && "$@")
}

list_databases() {
  local root="$1" dbtype="$2"
  case "$dbtype" in
    mysql | mariadb)
      local db
      in_project "$root" ddev mysql -N -B -e "SHOW DATABASES" | while read -r db; do
        [[ " $SYSTEM_DBS_MYSQL " == *" $db "* ]] || echo "$db"
      done
      ;;
    postgres)
      in_project "$root" ddev psql -At -c \
        "SELECT datname FROM pg_database WHERE NOT datistemplate AND datname <> 'postgres'"
      ;;
    *)
      die "tipo di database non supportato: $dbtype"
      ;;
  esac
}

# Postgres rifiuta di eliminare (e quindi di reimportare) un database con
# connessioni aperte: applicazione, worker, un client. Le chiude prima.
pg_close_connections() {
  local root="$1" db="$2"
  in_project "$root" ddev psql -d postgres -At -c \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity
     WHERE datname = '${db//\'/\'\'}' AND pid <> pg_backend_pid()" </dev/null >/dev/null 2>&1 || true
}

drop_database() {
  local root="$1" dbtype="$2" db="$3"
  case "$dbtype" in
    mysql | mariadb)
      in_project "$root" ddev mysql -e "DROP DATABASE \`${db//\`/\`\`}\`" </dev/null >/dev/null 2>&1
      ;;
    postgres)
      local quoted="\"${db//\"/\"\"}\""
      # WITH (FORCE) da Postgres 13; prima si chiudono le connessioni a mano.
      in_project "$root" ddev psql -d postgres -c "DROP DATABASE $quoted WITH (FORCE)" </dev/null >/dev/null 2>&1 || {
        pg_close_connections "$root" "$db"
        in_project "$root" ddev psql -d postgres -c "DROP DATABASE $quoted" </dev/null >/dev/null 2>&1
      }
      ;;
  esac
}

human_size() {
  numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"
}

# ---------------------------------------------------------------- lock

# Una sola operazione alla volta per progetto, da qualunque parte arrivi
# (pannello, terminale). Lock = cartella con dentro il PID: niente flock,
# perché ddev start può lasciare processi in background che erediterebbero
# il file descriptor e terrebbero il lock oltre la fine dello script. Un lock
# il cui PID non è più un ddev-backup vivo viene considerato abbandonato.
# Il backup di sicurezza lanciato da restore eredita il lock del padre.

LOCK_DIR=""

lock_path() {
  # Mai in /tmp: una cartella condivisa tra utenti.
  echo "${XDG_RUNTIME_DIR:-$HOME/.cache}/ddev-backup/$1.lock"
}

lock_holder_alive() {
  local pid
  pid="$(cat "$1/pid" 2>/dev/null)" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'ddev-backup'
}

acquire_lock() {
  local name="$1" path
  [[ ${DDEV_BACKUP_LOCKED:-} == "$name" ]] && return 0
  path="$(lock_path "$name")"
  mkdir -p "$(dirname "$path")"
  if ! mkdir "$path" 2>/dev/null; then
    lock_holder_alive "$path" && die "un'altra operazione è già in corso su $name"
    rm -rf -- "$path"
    mkdir "$path" 2>/dev/null || die "un'altra operazione è già in corso su $name"
  fi
  echo $$ >"$path/pid"
  LOCK_DIR="$path"
  export DDEV_BACKUP_LOCKED="$name"
}

release_lock() {
  [[ -n $LOCK_DIR ]] || return 0
  [[ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" == "$$" ]] && rm -rf -- "$LOCK_DIR"
  LOCK_DIR=""
}

# ---------------------------------------------------------------- spazio

SPACE_MARGIN=$((100 * 1024 * 1024))

available_bytes() {
  local path="$1"
  while [[ ! -e $path ]]; do path="$(dirname "$path")"; done
  # Solo per i test: simula un disco pieno.
  if [[ -n ${DDEV_BACKUP_TEST_AVAILABLE:-} ]]; then
    echo "$DDEV_BACKUP_TEST_AVAILABLE"
    return
  fi
  df -B1 --output=avail "$path" | tail -1 | tr -d ' '
}

# require_space <cartella> <byte necessari> <descrizione>
require_space() {
  local avail need
  avail="$(available_bytes "$1")"
  need=$(($2 + SPACE_MARGIN))
  ((avail >= need)) ||
    die "spazio insufficiente per $3 in $1: servono circa $(human_size "$need"), liberi $(human_size "$avail")"
}

# Dimensione dei database (dati + indici): stima per eccesso del dump.
databases_size() {
  local root="$1" dbtype="$2" size=""
  case "$dbtype" in
    mysql | mariadb)
      size="$(in_project "$root" ddev mysql -N -B -e \
        "SELECT COALESCE(SUM(data_length + index_length), 0) FROM information_schema.tables
         WHERE table_schema NOT IN ('information_schema', 'mysql', 'performance_schema', 'sys')" 2>/dev/null)"
      ;;
    postgres)
      size="$(in_project "$root" ddev psql -At -c \
        "SELECT COALESCE(SUM(pg_database_size(datname)), 0) FROM pg_database
         WHERE NOT datistemplate AND datname <> 'postgres'" 2>/dev/null)"
      ;;
  esac
  [[ $size =~ ^[0-9]+$ ]] && echo "$size" || echo 0
}

# ---------------------------------------------------------------- list

cmd_list() {
  local dest projects
  dest="$(backup_dir)"
  projects="$(ddev list --json-output 2>/dev/null | jq -c '[.raw[]? | select(.name != null and .approot != null and .approot != "") | {name, approot, status, type}]' 2>/dev/null || echo '[]')"
  [[ -n $projects ]] || projects='[]'

  # Tutti i backup presenti, raggruppati per cartella-progetto, con tipo,
  # nota e flag di sicurezza letti dal manifest di ciascuno.
  local backups='[]' zip_dir zip_file size mtime
  if [[ -d $dest ]]; then
    backups="$(find "$dest" -mindepth 2 -maxdepth 2 -type f -name '*.zip' -printf '%h\t%f\t%s\t%T@\n' 2>/dev/null |
      while IFS=$'\t' read -r zip_dir zip_file size mtime; do
        printf '%s\t%s\t%s\t%s\t%s\n' "$zip_dir" "$zip_file" "$size" "$mtime" "$(zip_manifest "$zip_dir/$zip_file")"
      done |
      jq -R -s -c --arg dest "$dest" '
        split("\n") | map(select(length > 0) | split("\t")) |
        map((.[4] | fromjson? // {}) as $m | {
          project: (.[0] | ltrimstr($dest + "/")), path: (.[0] + "/" + .[1]), file: .[1],
          size: (.[2] | tonumber), mtime: (.[3] | tonumber | floor),
          kind: ($m.kind // "full"), label: (if $m.label == "pre-restore" then "" else ($m.label // "") end),
          safety: ($m.safety // ($m.label == "pre-restore")),
          databases: [($m.database.databases // [])[].name],
          created: ($m.created // ""), host: ($m.host // ""),
          approot: ($m.project.approot // ""), projectType: ($m.project.type // ""),
          ddevVersion: ($m.project.ddevVersion // ""),
          dbType: ($m.database.type // ""), dbVersion: ($m.database.version // ""),
          git: ($m.git // null)
        }) |
        sort_by(-.mtime)')"
  fi

  jq -n -c --argjson projects "$projects" --argjson backups "$backups" --arg dest "$dest" '{
    backupDir: $dest,
    projects: ($projects | map(. as $p | . + {backups: [$backups[] | select(.project == $p.name)]})),
    orphans: ([$backups[] | select(.project as $n | ($projects | map(.name) | index($n)) == null)]
              | group_by(.project) | map({name: .[0].project, backups: (. | sort_by(-.mtime))}))
  }'
}

# ---------------------------------------------------------------- backup

# Nota scelta dall'utente -> pezzo di nome file: minuscole, [a-z0-9-], max 40.
slugify() {
  local slug
  slug="$(iconv -f utf-8 -t ascii//TRANSLIT <<<"$1" 2>/dev/null || echo "$1")"
  slug="$(tr '[:upper:]' '[:lower:]' <<<"$slug" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  slug="${slug:0:40}"
  echo "${slug%-}"
}

cmd_backup() {
  local name="" label="" kind="full" safety=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --db-only) kind="database"; shift ;;
      --label)
        [[ $# -ge 2 ]] || die "--label richiede un testo"
        label="$2"; shift 2 ;;
      # Interno: backup di sicurezza fatto da restore prima di sovrascrivere.
      --safety) safety=true; shift ;;
      -*) die "opzione sconosciuta: $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n $name ]] || die "uso: ddev-backup backup <progetto> [--db-only] [--label <nota>]"
  # La nota finisce nel manifest e nel pannello: una riga, niente caratteri
  # di controllo, lunghezza ragionevole.
  label="$(tr -d '[:cntrl:]' <<<"$label")"
  label="${label:0:100}"
  # Gli archivi contengono .env, chiavi e dump: leggibili solo dal
  # proprietario, come le cartelle che vengono create. Vale solo per questo
  # processo (anche i backup di sicurezza girano in un processo a parte), così
  # i file ripristinati mantengono i permessi originali.
  umask 077
  acquire_lock "$name"
  trap release_lock EXIT

  local info root status dbtype dbversion ptype
  info="$(describe "$name")" || true
  [[ -n $info && $info != null ]] || die "progetto DDEV non trovato: $name"
  root="$(jq -r .approot <<<"$info")"
  status="$(jq -r .status <<<"$info")"
  ptype="$(jq -r .type <<<"$info")"
  [[ -d $root ]] || die "cartella del progetto non trovata: $root"

  local was_stopped=0
  if [[ $status != running ]]; then
    step "Avvio di $name per esportare il database…"
    ddev start -y "$name" >/dev/null 2>&1 || die "impossibile avviare $name (Docker è attivo?)"
    was_stopped=1
    info="$(describe "$name")"
  fi
  dbtype="$(jq -r '.dbinfo.database_type // empty' <<<"$info")"
  dbversion="$(jq -r '.dbinfo.database_version // empty' <<<"$info")"
  [[ $kind == full || -n $dbtype ]] || die "$name non ha un database da salvare"

  local dest stamp out work suffix=""
  dest="$(backup_dir)/$name"
  mkdir -p "$dest"
  # Anche una cartella del progetto creata da una versione precedente.
  chmod 700 "$dest" 2>/dev/null || true
  stamp="$(date +%Y%m%d-%H%M%S)"
  [[ $kind == database ]] && suffix+="-db"
  [[ $safety == true ]] && suffix+="-pre-restore"
  [[ -n $label ]] && suffix+="-$(slugify "$label")"
  suffix="${suffix%-}"
  out="$dest/$name-$stamp$suffix.zip"
  work="$(mktemp -d "$dest/.work-XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf '$work' '$out.part'; [[ $was_stopped == 1 ]] && ddev stop '$name' >/dev/null 2>&1; release_lock" EXIT

  # Stima per eccesso: file e database non compressi. Il picco reale è
  # dump .gz + zip in costruzione, quasi sempre molto meno.
  step "Controllo dello spazio libero…"
  local du_excludes=() pattern files_size=0 db_size=0
  if [[ $kind == full ]]; then
    while IFS= read -r pattern; do
      [[ -n $pattern ]] && du_excludes+=(--exclude="$pattern")
    done < <(extra_excludes)
    files_size="$(du -sb "${du_excludes[@]}" "$root" 2>/dev/null | cut -f1)"
  fi
  [[ -n $dbtype ]] && db_size="$(databases_size "$root" "$dbtype")"
  require_space "$dest" $((${files_size:-0} + db_size)) "il backup"

  mkdir -p "$work/database"
  local dbs=() db
  if [[ -n $dbtype ]]; then
    mapfile -t dbs < <(list_databases "$root" "$dbtype")
    for db in "${dbs[@]}"; do
      [[ -n $db ]] || continue
      step "Esportazione database $db…"
      ddev export-db "$name" --database="$db" --file="$work/database/$db.sql.gz" </dev/null >/dev/null 2>&1 ||
        die "export del database $db fallito"
    done
  fi

  step "Scrittura manifest…"
  local git_commit="" git_branch="" git_dirty=false
  if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    git_commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
    git_branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
    [[ -z "$(git -C "$root" status --porcelain 2>/dev/null | head -c1)" ]] || git_dirty=true
  fi

  local dbjson='[]'
  for db in "${dbs[@]}"; do
    [[ -n $db ]] || continue
    dbjson="$(jq -c --arg n "$db" --arg f "database/$db.sql.gz" \
      --arg sha "$(sha256sum "$work/database/$db.sql.gz" | cut -d' ' -f1)" \
      '. + [{name: $n, file: $f, sha256: $sha}]' <<<"$dbjson")"
  done

  jq -n \
    --arg format "$FORMAT" --argjson fv "$FORMAT_VERSION" --arg tool "$VERSION" \
    --arg kind "$kind" --argjson safety "$safety" \
    --arg name "$name" --arg root "$root" --arg ptype "$ptype" \
    --arg dbtype "$dbtype" --arg dbversion "$dbversion" \
    --arg ddev "$(ddev version -j 2>/dev/null | jq -r '.raw["DDEV version"] // empty')" \
    --arg created "$(date -Iseconds)" --arg host "$(hostname)" --arg label "$label" \
    --arg commit "$git_commit" --arg branch "$git_branch" --argjson dirty "$git_dirty" \
    --argjson dbs "$dbjson" '{
      format: $format, formatVersion: $fv, toolVersion: $tool,
      kind: $kind, safety: $safety,
      created: $created, host: $host, label: $label,
      project: {name: $name, approot: $root, type: $ptype, ddevVersion: $ddev},
      database: {type: $dbtype, version: $dbversion, databases: $dbs},
      git: (if $commit == "" then null else {commit: $commit, branch: $branch, dirty: $dirty} end)
    }' >"$work/manifest.json"

  if [[ $kind == full ]]; then
    step "Compressione dei file del progetto…"
    local excludes=()
    for pattern in "${DEFAULT_EXCLUDES[@]}"; do excludes+=(--exclude "$pattern"); done
    while IFS= read -r pattern; do
      [[ -n $pattern ]] && excludes+=(--exclude "$pattern")
    done < <(extra_excludes)
    # File opzionale nel progetto con pattern aggiuntivi (uno per riga).
    if [[ -f $root/.ddev-backup-ignore ]]; then
      while IFS= read -r pattern; do
        [[ -n $pattern && $pattern != \#* ]] && excludes+=(--exclude "$pattern")
      done <"$root/.ddev-backup-ignore"
    fi

    # Prima manifest e database (letti velocemente da inspect/restore), poi i
    # file del progetto sotto files/. bsdtar conserva i symlink come tali.
    bsdtar --format zip -cf "$out.part" "${excludes[@]}" -s ',^\./,files/,' -s ',^\.$,files,' \
      -C "$work" manifest.json database -C "$root" . ||
      die "creazione dell'archivio fallita"
  else
    step "Compressione dei dump…"
    bsdtar --format zip -cf "$out.part" -C "$work" manifest.json database ||
      die "creazione dell'archivio fallita"
  fi

  step "Verifica dell'archivio…"
  bsdtar -xOf "$out.part" >/dev/null 2>&1 || die "archivio corrotto, backup annullato"
  mv "$out.part" "$out"
  chmod 600 "$out" 2>/dev/null || true

  prune "$dest"

  local size what="Backup"
  size="$(stat -c %s "$out")"
  [[ $kind == database ]] && what="Backup del database"
  notify "$what completato" "$name → $(basename "$out") ($(human_size "$size"))"
  echo "DONE: $out"
}

# Tiene gli ultimi `keep` backup completi e `keepDb` backup del solo
# database (0 = tutti). I backup di sicurezza fatti prima di un restore non
# contano nel limite e non vengono mai cancellati automaticamente.
prune() {
  local dir="$1" keep_full keep_db n_full=0 n_db=0 path kind safety
  keep_full="$(keep_count full)"
  keep_db="$(keep_count database)"
  [[ $keep_full -gt 0 || $keep_db -gt 0 ]] || return 0
  while IFS=$'\t' read -r _ path; do
    IFS=$'\t' read -r kind safety < <(zip_manifest "$path" | jq -r '[.kind // "full", (.safety // (.label == "pre-restore"))] | @tsv')
    [[ $safety == true ]] && continue
    if [[ $kind == database ]]; then
      n_db=$((n_db + 1))
      [[ $keep_db -gt 0 && $n_db -gt $keep_db ]] && rm -f -- "$path"
    else
      n_full=$((n_full + 1))
      [[ $keep_full -gt 0 && $n_full -gt $keep_full ]] && rm -f -- "$path"
    fi
  done < <(find "$dir" -maxdepth 1 -type f -name '*.zip' -printf '%T@\t%p\n' | sort -rn)
  return 0
}

# Manifest di uno zip su una riga, o {} se non leggibile.
zip_manifest() {
  bsdtar -xOf "$1" manifest.json 2>/dev/null | jq -c . 2>/dev/null || echo '{}'
}

# ---------------------------------------------------------------- inspect

read_manifest() {
  local zip="$1" manifest
  [[ -f $zip ]] || die "file non trovato: $zip"
  manifest="$(bsdtar -xOf "$zip" manifest.json 2>/dev/null)" || die "manifest.json mancante: non è un backup ddev-backup"
  jq -e --arg f "$FORMAT" '.format == $f' <<<"$manifest" >/dev/null 2>&1 || die "formato non riconosciuto"
  local fv
  fv="$(jq -r .formatVersion <<<"$manifest")"
  [[ $fv -le $FORMAT_VERSION ]] || die "backup creato con una versione più recente (formato $fv)"
  echo "$manifest"
}

cmd_inspect() {
  [[ -n ${1:-} ]] || die "uso: ddev-backup inspect <file.zip>"
  read_manifest "$1" | jq .
}

# ---------------------------------------------------------------- restore

restore_cleanup() {
  local rc=$?
  if [[ $rc != 0 && $R_SWAPPED == 1 ]]; then
    # Il restore è fallito dopo aver sostituito la cartella: rimette quella
    # originale (o toglie quella parziale se prima non c'era niente).
    rm -rf -- "$R_TARGET"
    if [[ -n $R_OLD && -d $R_OLD ]]; then
      mv -- "$R_OLD" "$R_TARGET"
      echo "ERROR: cartella originale rimessa in $R_TARGET" >&2
    fi
    if [[ -n $R_SAFETY ]]; then
      echo "ERROR: il database precedente è nel backup di sicurezza; per recuperarlo:" >&2
      echo "ERROR:   ddev-backup restore '$R_SAFETY' --force --no-safety-backup" >&2
    fi
    ddev delete --omit-snapshot -y "$R_NAME" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$R_WORK"
  release_lock
  exit "$rc"
}

# Restore di un backup del solo database: i file del progetto non vengono
# toccati; il progetto deve esistere già (stesso nome, o --name). Come il
# restore completo è esatto: i database creati dopo il backup vengono
# eliminati (restano nel backup di sicurezza).
database_cleanup() {
  local rc=$?
  if [[ $rc != 0 && -n $D_SAFETY ]]; then
    echo "ERROR: il database precedente è nel backup di sicurezza; per recuperarlo:" >&2
    echo "ERROR:   ddev-backup restore '$D_SAFETY' --force --no-safety-backup" >&2
  fi
  [[ -n $D_WORK ]] && rm -rf -- "$D_WORK"
  release_lock
  exit "$rc"
}

restore_database() {
  local zip="$1" manifest="$2" name="$3" force="$4" safety="$5"
  local info root dbtype wanted
  info="$(describe "$name" || true)"
  [[ -n $info && $info != null ]] ||
    die "il progetto $name non esiste: un backup del solo database si ripristina su un progetto DDEV esistente"
  [[ $force == 1 ]] || die "i database di $name verranno sovrascritti: usa --force per confermare"
  root="$(jq -r .approot <<<"$info")"

  if [[ "$(jq -r .status <<<"$info")" != running ]]; then
    step "Avvio di $name…"
    ddev start -y "$name" >/dev/null 2>&1 || die "impossibile avviare $name (Docker è attivo?)"
    info="$(describe "$name")"
  fi
  dbtype="$(jq -r '.dbinfo.database_type // empty' <<<"$info")"
  wanted="$(jq -r '.database.type' <<<"$manifest")"
  [[ $dbtype == "$wanted" ]] ||
    die "il backup è di un database $wanted, il progetto $name usa ${dbtype:-nessun database}"

  local dest unpacked
  dest="$(backup_dir)/$name"
  mkdir -p "$dest"
  unpacked="$(unzip -Zt "$zip" 2>/dev/null | sed -n 's/.* \([0-9]\+\) bytes uncompressed.*/\1/p')"
  require_space "$dest" "${unpacked:-0}" "l'estrazione dei dump"
  D_WORK="$(mktemp -d "$dest/.work-XXXXXX")" D_SAFETY=""
  trap database_cleanup EXIT

  step "Estrazione dei dump…"
  bsdtar -xf "$zip" -C "$D_WORK" manifest.json database || die "estrazione fallita"
  local db file sha
  while IFS=$'\t' read -r db file sha; do
    [[ -n $db ]] || continue
    [[ "$(sha256sum "$D_WORK/$file" | cut -d' ' -f1)" == "$sha" ]] || die "checksum errato per il database $db"
  done < <(jq -r '.database.databases[] | [.name, .file, .sha256] | @tsv' <<<"$manifest")

  if [[ $safety == 1 ]]; then
    step "Backup di sicurezza del database attuale…"
    D_SAFETY="$(DDEV_BACKUP_NOTIFY=0 "$0" backup "$name" --db-only --safety | sed -n 's/^DONE: //p')" ||
      die "backup di sicurezza fallito, restore annullato"
    [[ -f $D_SAFETY ]] || die "backup di sicurezza fallito, restore annullato"
    step "Backup di sicurezza: $D_SAFETY"
  fi

  local keep=" "
  while IFS=$'\t' read -r db file; do
    [[ -n $db ]] || continue
    keep+="$db "
    step "Importazione database $db…"
    [[ $dbtype == postgres ]] && pg_close_connections "$root" "$db"
    in_project "$root" ddev import-db --database="$db" --file="$D_WORK/$file" --no-progress </dev/null >/dev/null 2>&1 ||
      die "import del database $db fallito"
  done < <(jq -r '.database.databases[] | [.name, .file] | @tsv' <<<"$manifest")

  for db in $(list_databases "$root" "$dbtype"); do
    [[ $keep == *" $db "* ]] && continue
    step "Eliminazione database $db (creato dopo il backup)…"
    drop_database "$root" "$dbtype" "$db" || die "impossibile eliminare il database $db"
  done

  notify "Restore del database completato" "$name: database al $(jq -r .created <<<"$manifest" | cut -c1-16 | tr T ' ')"
  echo "DONE: $root"
}

cmd_restore() {
  local zip="" target="" newname="" force=0 safety=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to) target="$2"; shift 2 ;;
      --name) newname="$2"; shift 2 ;;
      --force) force=1; shift ;;
      --no-safety-backup) safety=0; shift ;;
      -*) die "opzione sconosciuta: $1" ;;
      *) zip="$1"; shift ;;
    esac
  done
  [[ -n $zip ]] || die "uso: ddev-backup restore <file.zip> [--to <cartella>] [--name <nome>] [--force]"
  zip="$(realpath "$zip")"

  local manifest name origroot
  manifest="$(read_manifest "$zip")"
  name="$(jq -r .project.name <<<"$manifest")"
  origroot="$(jq -r .project.approot <<<"$manifest")"
  [[ -n $newname ]] && name="$newname"
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || die "nome progetto non valido: $name (solo lettere, cifre e trattini)"
  acquire_lock "$name"
  trap release_lock EXIT

  if [[ "$(jq -r '.kind // "full"' <<<"$manifest")" == database ]]; then
    [[ -z $target ]] || die "un backup del solo database non ha file: --to non si applica"
    restore_database "$zip" "$manifest" "$name" "$force" "$safety"
    return
  fi

  target="${target:-$origroot}"
  target="$(realpath -m "$target")"

  # Il nome è già usato da un altro progetto DDEV in un'altra cartella?
  local existing existing_root=""
  existing="$(describe "$name" || true)"
  if [[ -n $existing && $existing != null ]]; then
    existing_root="$(jq -r .approot <<<"$existing")"
    if [[ $existing_root != "$target" ]]; then
      die "esiste già un progetto '$name' in $existing_root: usa --name per ripristinarlo con un altro nome"
    fi
  fi

  local in_place=0
  if [[ -e $target ]] && [[ -n "$(ls -A "$target" 2>/dev/null)" ]]; then
    [[ $force == 1 ]] || die "la cartella $target esiste e non è vuota: usa --force per sovrascriverla"
    in_place=1
  fi

  local parent work unpacked
  parent="$(dirname "$target")"
  # L'archivio viene estratto accanto alla destinazione: serve spazio per
  # tutto il contenuto decompresso. (Il backup di sicurezza fa il suo
  # controllo, sulla cartella dei backup.)
  unpacked="$(unzip -Zt "$zip" 2>/dev/null | sed -n 's/.* \([0-9]\+\) bytes uncompressed.*/\1/p')"
  require_space "$parent" "${unpacked:-0}" "l'estrazione dell'archivio"
  mkdir -p "$parent"
  work="$(mktemp -d "$parent/.ddev-restore-XXXXXX")"
  # Stato letto da restore_cleanup all'uscita (variabili globali, non local,
  # perché il trap EXIT gira dopo che la funzione è terminata).
  R_WORK="$work" R_TARGET="$target" R_OLD="" R_SWAPPED=0 R_SAFETY="" R_NAME="$name"
  trap restore_cleanup EXIT

  step "Estrazione dell'archivio…"
  bsdtar -xf "$zip" -C "$work" || die "estrazione fallita"
  [[ -d $work/files ]] || die "archivio senza cartella files/"

  local db file sha
  while IFS=$'\t' read -r db file sha; do
    [[ -n $db ]] || continue
    [[ "$(sha256sum "$work/$file" | cut -d' ' -f1)" == "$sha" ]] || die "checksum errato per il database $db"
  done < <(jq -r '.database.databases[] | [.name, .file, .sha256] | @tsv' <<<"$manifest")

  if [[ $in_place == 1 ]]; then
    if [[ -n $existing_root && $safety == 1 ]]; then
      step "Backup di sicurezza dello stato attuale…"
      R_SAFETY="$(DDEV_BACKUP_NOTIFY=0 "$0" backup "$name" --safety | sed -n 's/^DONE: //p')" ||
        die "backup di sicurezza fallito, restore annullato"
      [[ -f $R_SAFETY ]] || die "backup di sicurezza fallito, restore annullato"
      step "Backup di sicurezza: $R_SAFETY"
    fi
    if [[ -n $existing_root ]]; then
      step "Rimozione dei container e del database attuali…"
      ddev delete --omit-snapshot -y "$name" >/dev/null 2>&1 || die "ddev delete $name fallito"
    fi
    R_OLD="$work/old"
    mv "$target" "$R_OLD"
  fi

  step "Ripristino dei file in $target…"
  mv "$work/files" "$target"
  R_SWAPPED=1

  if [[ -n $newname ]]; then
    in_project "$target" ddev config --project-name="$name" >/dev/null 2>&1 || die "ddev config fallito"
  fi

  step "Avvio di $name…"
  in_project "$target" ddev start -y >/dev/null 2>&1 || die "ddev start fallito"

  while IFS=$'\t' read -r db file; do
    [[ -n $db ]] || continue
    step "Importazione database $db…"
    [[ $(jq -r .database.type <<<"$manifest") == postgres ]] && pg_close_connections "$target" "$db"
    in_project "$target" ddev import-db --database="$db" --file="$work/$file" --no-progress </dev/null >/dev/null 2>&1 ||
      die "import del database $db fallito"
  done < <(jq -r '.database.databases[] | [.name, .file] | @tsv' <<<"$manifest")

  R_SWAPPED=0
  # Senza backup di sicurezza (cartella non DDEV o --no-safety-backup) la
  # vecchia cartella non viene cancellata ma tenuta accanto a quella nuova.
  if [[ -n $R_OLD && -z $R_SAFETY && -d $R_OLD ]]; then
    local kept="$target.pre-restore-$(date +%Y%m%d-%H%M%S)"
    mv "$R_OLD" "$kept"
    step "Vecchia cartella conservata in $kept"
  fi
  notify "Restore completato" "$name ripristinato in $target"
  echo "DONE: $target"
}

# ---------------------------------------------------------------- delete

cmd_delete() {
  local zip="${1:-}" dest
  [[ -n $zip && -f $zip ]] || die "uso: ddev-backup delete <file.zip>"
  dest="$(realpath "$(backup_dir)")"
  zip="$(realpath "$zip")"
  [[ $zip == "$dest"/*/*.zip ]] || die "posso cancellare solo i backup dentro $dest"
  # Non cancellare un backup mentre lo stesso progetto viene ripristinato.
  acquire_lock "$(basename "$(dirname "$zip")")"
  trap release_lock EXIT
  rm -f -- "$zip"
  echo "DONE: $zip"
}

usage() {
  cat <<EOF
ddev-backup $VERSION — backup e restore di progetti DDEV (file + database) in .zip

Uso:
  ddev-backup list                          Progetti DDEV e backup esistenti (JSON)
  ddev-backup backup <progetto> [opzioni]   Crea un backup in <backupDir>/<progetto>/
      --db-only           Solo i database (veloce, es. prima di una migrazione)
      --label <nota>      Nota libera, salvata nel manifest e nel nome del file
  ddev-backup inspect <file.zip>            Mostra il manifest di un backup
  ddev-backup restore <file.zip> [opzioni]  Ripristina file e database
      --to <cartella>     Destinazione (default: cartella originale)
      --name <nome>       Ripristina come nuovo progetto con un altro nome
      --force             Sovrascrive progetto/database esistenti (dopo un backup di sicurezza)
      --no-safety-backup  Non fare il backup di sicurezza prima di sovrascrivere
  ddev-backup delete <file.zip>             Cancella un backup

Un backup --db-only si ripristina sul progetto esistente con lo stesso nome
(o --name) e non tocca i file.

Impostazioni: quelle del pannello, salvate in $SHELL_CONFIG
(voce $PLUGIN_ID): backupDir, keep, keepDb, exclude, notify.
EOF
}

for dep in ddev jq bsdtar sha256sum; do
  command -v "$dep" >/dev/null 2>&1 || die "comando richiesto non trovato: $dep"
done

case "${1:-}" in
  list) shift; cmd_list "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  inspect) shift; cmd_inspect "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  version | --version) echo "$VERSION" ;;
  "" | -h | --help | help) usage ;;
  *) usage >&2; exit 1 ;;
esac
